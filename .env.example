# Copy to .env.local and adjust. All variables are optional and are baked in at build time.

# Moonraker base URL (http/https). Leave empty to use http://<page hostname>:7125.
VITE_LAYR_MOONRAKER_URL=

# Display name shown in the top bar. Falls back to the Klipper host name.
VITE_LAYR_PRINTER_NAME=

# Optional Moonraker API key. Prefer Moonraker `trusted_clients` for a local kiosk instead:
# anything set here is embedded in the built JavaScript and readable by anyone who can load the page.
VITE_LAYR_API_KEY=

# Start in demo mode with a sample scenario: printing | paused | ready | complete | heating | error | disconnected | connecting
VITE_LAYR_DEMO=
