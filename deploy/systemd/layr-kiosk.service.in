# LAYR kiosk: Chromium in the cage Wayland compositor on its own VT (tty7), as a separate session from
# KlipperScreen. install.sh installs this unit but never enables or starts it; use deploy/layr-display.sh.
# @VARS@ are replaced at install time.
[Unit]
Description=LAYR kiosk display (Chromium in cage on tty7)
After=systemd-user-sessions.service systemd-logind.service dbus.service polkit.service network-online.target @WEB_UNIT@
Requires=systemd-logind.service dbus.service polkit.service
Wants=@WEB_UNIT@ network-online.target
Conflicts=getty@tty7.service
ConditionPathExists=/dev/tty7

[Service]
Type=simple
User=@USER@
PAMName=layr-kiosk
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
EnvironmentFile=@LAYR_HOME@/layr.env
# Register a local Wayland session; pam_systemd supplies the session ID/runtime.
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=7
Environment=LIBSEAT_BACKEND=logind
UnsetEnvironment=DISPLAY WAYLAND_DISPLAY
# The supervisor owns PAM's (sd-pam) child. Cage is its unprivileged child.
ExecStart=/usr/bin/python3 @LAYR_HOME@/bin/layr-session.py
KillMode=mixed
TimeoutStopSec=10s
SendSIGKILL=yes
Restart=no

[Install]
WantedBy=multi-user.target
