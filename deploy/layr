def run_probe(command, timeout=8):
    try:
        result = subprocess.run(list(map(str, command)), text=True, capture_output=True, timeout=timeout)
        return dict(command=list(map(str, command)), returncode=result.returncode, stdout=result.stdout.strip(), stderr=result.stderr.strip())
    except (OSError, subprocess.TimeoutExpired) as error:
        return dict(command=list(map(str, command)), returncode=None, stdout='', stderr=str(error))


def probe_web():
    port = '7180'
    path = ROOT / 'layr.env'
    if path.is_file():
        matches = re.findall(r'^LAYR_PORT=([0-9]+)$', path.read_text(), re.M)
        if matches:
            port = matches[-1]
    if not 1 <= int(port) <= 65535:
        return dict(ok=False, error='Invalid local web port', url='unknown')
    url = f'http://127.0.0.1:{port}/'
    result = run_probe(['curl', '--fail', '--silent', '--show-error', '--max-time', '3', '--max-filesize', '2000000', url], timeout=5)
    error = result['stderr'] or ('HTTP probe failed' if result['returncode'] != 0 else '')
    if result['returncode'] == 0:
        expected = ROOT / 'current/index.html'
        try:
            if hashlib.sha256(result['stdout'].encode()).digest() != hashlib.sha256(expected.read_text().strip().encode()).digest():
                error = 'HTTP response does not match the installed LAYR index; check port conflicts or stale services'
        except OSError as exc:
            error = 'Installed index unavailable: ' + str(exc)
    return dict(ok=result['returncode'] == 0 and not error, error=error, url=url)


