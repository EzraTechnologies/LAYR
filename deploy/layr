def display_confirmed():
    try:
        record = json.loads((ROOT / 'state/display-verification.json').read_text())
        machine = Path('/etc/machine-id').read_text().strip()
        return (bool(machine) and record.get('machine_id') == machine
                and record.get('display') == 'operator-confirmed'
                and record.get('service') == 'layr-kiosk.service'
                and record.get('chromium_backend') == configured_chromium_backend()
                and not record.get('invalidated_at'))
    except (OSError, ValueError, AttributeError):
        return False


def enable_kiosk(options):
    backend = validate_chromium_backend(configured_chromium_backend())
    if not probe_web()['ok'] or capture('systemctl', 'is-active', 'layr-kiosk.service') != 'active':
        raise RuntimeError('Start a temporary kiosk preview and validate local HTTP first. Boot startup was not enabled.')
    if options.dry_run:
        print('Dry run: boot startup would require a visible display test and explicit VISIBLE confirmation.')
        return
    if not sys.stdin.isatty():
        raise RuntimeError('Boot startup requires physical display confirmation from an interactive terminal; --yes cannot bypass it.')
    if running_service_backend() != backend:
        raise RuntimeError('Current service backend does not match the saved backend, or cannot be verified. Use layr recover, then layr switch layr and physically validate that service preview. Boot startup was not enabled.')
    answer = input('Only if the LAYR UI from layr-kiosk.service is visible and usable on this device, type VISIBLE (manual Cage, a flashing cursor or active service is insufficient): ')
    if answer.strip() != 'VISIBLE':
        raise RuntimeError('Display was not confirmed. Boot startup remains unchanged; recover with layr recover.')
    touch = input('Have you tested real touchscreen interaction successfully? [y/N] ').strip().lower() == 'y'
    if not probe_web()['ok'] or capture('systemctl', 'is-active', 'layr-kiosk.service') != 'active':
        raise RuntimeError('Kiosk/web stopped during confirmation. Boot startup was not enabled.')
    if running_service_backend() != backend or configured_chromium_backend() != backend:
        raise RuntimeError('Service backend changed or became unverifiable during confirmation. Boot startup was not enabled.')
    path = ROOT / 'state/display-verification.json'
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(dict(at=datetime.now(timezone.utc).isoformat(), release=str((ROOT / 'current').resolve()), machine_id=Path('/etc/machine-id').read_text().strip(), service='layr-kiosk.service', chromium_backend=backend, display='operator-confirmed', touchscreen='operator-confirmed' if touch else 'unverified')) + '\n')
    execute(['sudo', 'systemctl', 'enable', 'layr-kiosk.service'])
    print('Kiosk boot startup enabled after operator confirmation. This is not automatic proof of future rendering or input readiness.')


