DEPLOY = Path(__file__).resolve().parent
# A global symlink must keep targeting its installation, regardless of the
# caller's HOME. Checkout invocation still supports isolated installation roots.
ROOT = DEPLOY.parent if DEPLOY.name == 'management' else Path(os.environ.get('LAYR_HOME', str(Path.home() / 'layr'))).resolve()
POWER_HELPER = Path('/usr/local/lib/layr-display-power/controller.py')



def capture(*args):
    try:
        result = subprocess.run(args, text=True, capture_output=True, timeout=15)
        return result.stdout.strip() if result.returncode == 0 else ''
    except (OSError, subprocess.TimeoutExpired):
        return ''


def detect(base=Path('/')):
    fields = {}
    for line in (base / 'etc/os-release').read_text().splitlines():
        if '=' in line:
            key, value = line.split('=', 1)
            fields[key] = value.strip('"\'')
    arch = capture('dpkg', '--print-architecture')
    kernel_arch = capture('uname', '-m')
    release_ok = fields.get('VERSION_ID') == '12' if fields.get('VERSION_ID') else fields.get('VERSION_CODENAME') == 'bookworm'
    supported = arch in ('i386', 'amd64', 'armhf', 'arm64') and fields.get('ID') in ('debian', 'raspbian', 'mainsailos') and release_ok and kernel_arch not in ('armv6l', 'armv5tel')
    model = base / 'proc/device-tree/model'
    memory = (base / 'proc/meminfo').read_text()
    inputs = base / 'proc/bus/input/devices'
    touch = touch_inventory(base, inputs)
    return dict(architecture=arch, kernel_architecture=kernel_arch, distribution=fields, supported=supported,
                model=model.read_text().strip('\0') if model.exists() else capture('cat', str(base / 'sys/class/dmi/id/product_name')) or 'unknown',
                cpu=capture('lscpu'),
                graphics={p.parent.name: str((p.parent / 'device/driver').resolve()) for p in (base / 'sys/class/drm').glob('card*/dev')},
                disk_free_mb=shutil.disk_usage(base).free // (1024 * 1024),
                ram_available_mb=(int(re.search(r'MemAvailable:\s+(\d+)', memory)[1]) // 1024 if 'MemAvailable:' in memory else None),
                ram_mb=int(re.search(r'MemTotal:\s+(\d+)', memory)[1]) // 1024,
                connectors={p.parent.name: p.read_text().strip() for p in (base / 'sys/class/drm').glob('card*-*/status')},
                touchscreen=touch['detection'],
                touch_devices=touch['devices'], touchscreen_function='unverified',
                graphical_environment={key: os.environ.get(key, '') for key in ('XDG_SESSION_TYPE', 'DISPLAY', 'WAYLAND_DISPLAY')},
                services={unit: capture('systemctl', 'is-active', unit) or 'inactive/unknown' for unit in ('display-manager.service', 'KlipperScreen.service', 'klipper.service', 'moonraker.service', 'layr-web.service', 'layr-kiosk.service')})


def prompt_endpoint(default='localhost:7125'):
    value = input(f'Moonraker IP, hostname or URL [{default}]: ').strip() or default
    if ':' not in value:
        port = input('Moonraker port [7125]: ').strip() or '7125'
        if not port.isdigit() or not 1 <= int(port) <= 65535:
            raise RuntimeError('Moonraker port must be between 1 and 65535')
        value += ':' + port
    return value


def moonraker(value):
    if '://' not in value:
        value = 'http://' + value + ':7125' if ':' not in value else 'http://' + value
    try:
        parsed = urlsplit(value)
        port = parsed.port
        if parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username or parsed.password or parsed.query or parsed.fragment or parsed.path not in ('', '/') or re.search(r'[\s\x00-\x1f\x7f\\\'"`$]', value):
            raise ValueError()
        if port is not None and not 1 <= port <= 65535:
            raise ValueError()
    except ValueError:
        raise RuntimeError('Moonraker must be an HTTP(S) hostname/IP URL without credentials, query or path')
    return value.rstrip('/')


def execute(args, dry=False):
    print('+ ' + ' '.join(map(str, args)), flush=True)
    if not dry:
        subprocess.run(list(map(str, args)), check=True)


def saved():
    path = ROOT / 'state/installer.json'
    state = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(state, dict):
        raise RuntimeError('Invalid installer state; restore state/installer.json or run install with explicit configuration')
    return state


def installed_endpoint():
    path = ROOT / 'layr.env'
    if path.is_file():
        matches = re.findall(r'^LAYR_MOONRAKER_URL=(.*)$', path.read_text(), re.M)
        if matches:
            return matches[-1]
    return None


def configured_chromium_backend():
    """Read systemd's saved browser setting without evaluating shell content."""
    path = ROOT / 'layr.env'
    if path.is_file():
        matches = re.findall(r'^LAYR_CHROMIUM_BACKEND=(.*)$', path.read_text(), re.M)
        if matches:
            value = matches[-1].strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
                value = value[1:-1]
            return value
    return 'wayland'


def validate_chromium_backend(value):
    if value not in ('wayland', 'x11'):
        raise RuntimeError('LAYR_CHROMIUM_BACKEND must be wayland or x11; no backend fallback was attempted')
    return value


def running_service_backend():
    pid = capture('systemctl', 'show', 'layr-kiosk.service', '-p', 'MainPID', '--value')
    if not pid.isdigit() or int(pid) <= 0:
        return None
    try:
        environment = Path(f'/proc/{pid}/environ').read_bytes()
    except OSError:
        return None
    if not environment:
        return None
    for field in environment.split(b'\0'):
        if field.startswith(b'LAYR_CHROMIUM_BACKEND='):
            return field.partition(b'=')[2].decode(errors='replace')
    return 'wayland'


def select_chromium_backend(options, facts, profile):
    explicit = getattr(options, 'chromium_backend', None) or os.environ.get('LAYR_CHROMIUM_BACKEND')
    current = configured_chromium_backend()
    if explicit is not None:
        return validate_chromium_backend(explicit)
    if profile == 'kiosk' and not options.yes and sys.stdin.isatty():
        installed = (ROOT / 'layr.env').is_file()
        intel_kiosk = facts['architecture'] in ('i386', 'amd64')
        default = current if installed else ('x11' if intel_kiosk else 'wayland')
        if intel_kiosk:
            print('Older Intel tablets: X11 through XWayland is recommended for touch. Native Wayland remains selectable. This does not verify service startup.')
        return validate_chromium_backend(input(f'Chromium backend (x11 / wayland) [{default}]: ').strip() or default)
    return validate_chromium_backend(current)


def save_chromium_backend(backend):
    path = ROOT / 'layr.env'
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = path.read_text().splitlines() if path.is_file() else []
    lines = [line for line in lines if not line.startswith('LAYR_CHROMIUM_BACKEND=')]
    temp = path.with_suffix('.tmp')
    with os.fdopen(os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as handle:
        handle.write('\n'.join(lines + ['LAYR_CHROMIUM_BACKEND=' + backend]) + '\n')
    temp.chmod(0o600)
    temp.replace(path)


def invalidate_display_confirmation():
    path = ROOT / 'state/display-verification.json'
    if path.exists():
        try:
            record = json.loads(path.read_text())
            if not isinstance(record, dict):
                record = {}
        except ValueError:
            record = {}
        record['invalidated_at'] = datetime.now(timezone.utc).isoformat()
        record['invalidated_reason'] = 'Chromium backend changed; service-based physical validation required'
        path.write_text(json.dumps(record) + '\n')


def backend_config(options):
    backend = getattr(options, 'chromium_backend', None)
    current = configured_chromium_backend()
    print('Configured Chromium backend:', current)
    if backend is None:
        print('Select with layr backend --chromium-backend x11|wayland, or the Display and touchscreen menu.')
        return
    validate_chromium_backend(backend)
    if not (ROOT / 'layr.env').is_file():
        raise RuntimeError('Install LAYR before changing its browser backend')
    require_privileges(interactive=not options.yes)
    packages = ['xwayland'] if backend == 'x11' else []
    for package in packages:
        if not re.search(r'Candidate:\s+(?!\(none\))\S+', capture('apt-cache', 'policy', package)):
            raise RuntimeError(f'No compatible APT candidate for {package}; browser configuration was not changed')
    if packages:
        apt_plan(packages)
    if not options.yes and not options.dry_run:
        if not sys.stdin.isatty() or input(f'Save Chromium backend {backend}? The kiosk will not restart; changed backends disable boot startup. [y/N] ').lower() != 'y':
            raise RuntimeError('Cancelled; browser configuration was not changed')
    changed = backend != current
    if changed and capture('systemctl', 'list-unit-files', '--no-legend', 'layr-kiosk.service').startswith('layr-kiosk.service '):
        execute(['sudo', 'systemctl', 'disable', 'layr-kiosk.service'], options.dry_run)
    if packages:
        install_packages(packages, options.dry_run)
    if not options.dry_run:
        if changed:
            invalidate_display_confirmation()
        save_chromium_backend(backend)
    print(f'Chromium backend {backend}: ' + ('dry run; no configuration changed.' if options.dry_run else 'saved; the current browser was not restarted.'))
    print('Use layr recover to stop an existing kiosk, then layr switch layr for a service-based preview. Only after physical validation: layr enable-kiosk.')


def require_privileges(interactive=False):
    """Use the same validation as the shell installers, without changing files."""
    if os.geteuid() == 0:
        raise RuntimeError('Run LAYR as its normal installation owner, not root. Use the root account only to install sudo and grant that user access; see docs/mecer-bt26-test.md.')
    lib = DEPLOY / 'lib.sh'
    if not lib.is_file() or not lib.read_text().rstrip().endswith('\n# LAYR_SCRIPT_END'):
        raise RuntimeError('Privilege preflight requires a complete deploy/lib.sh; no changes were made')
    interactive = interactive and sys.stdin.isatty()
    try:
        result = subprocess.run(
            ['bash', '-c', '. "$1"; LAYR_PRIVILEGE_INTERACTIVE=$2; require_not_root',
             'layr-privilege-check', str(lib), '1' if interactive else '0'],
            text=True, stdout=subprocess.PIPE, stderr=None if interactive else subprocess.PIPE,
            timeout=None if interactive else 30,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError('sudo privilege validation timed out; no changes were made') from error
    if result.returncode:
        raise RuntimeError(result.stderr.strip() if result.stderr else 'sudo privilege validation failed; see the setup instructions above. No changes were made.')


def install(options, facts):
    if not facts['supported']:
        raise RuntimeError(f'Unsupported OS/architecture: {facts["distribution"].get("ID", "unknown")} {facts["distribution"].get("VERSION_ID", "unknown")} / {facts["architecture"]} (kernel {facts.get("kernel_architecture", "unknown")}); require Debian 12, Raspberry Pi OS or MainsailOS Bookworm; i386, amd64, armhf (ARMv7+) or arm64')
    if os.geteuid() == 0:
        raise RuntimeError('Run as the intended LAYR user, not root; sudo is used only where needed')
    for name in ('install.sh', 'lib.sh', 'layr-display.sh', 'rollback.sh', 'uninstall.sh', 'layr-session.py', 'pam/layr-kiosk'):
        script = DEPLOY / name
        if not script.is_file() or not script.read_text().rstrip().endswith('\n# LAYR_SCRIPT_END'):
            raise RuntimeError(f'Incomplete management script: {script}; no changes made')
    require_privileges(interactive=not options.yes)
    global_cli = Path('/usr/local/bin/layr')
    if global_cli.exists() or global_cli.is_symlink():
        if not global_cli.is_symlink() or os.readlink(global_cli) != str(ROOT / 'management/layr'):
            raise RuntimeError('/usr/local/bin/layr belongs to another installation; no changes made')
    print_hardware(facts)
    state = saved()
    profile = options.profile or state.get('profile')
    if getattr(options, 'command', None) == 'configure' and sys.stdin.isatty():
        if not options.profile:
            profile = input(f'Profile (headless / desktop / kiosk) [{profile or "headless"}]: ').strip() or profile or 'headless'
    if not profile:
        if not sys.stdin.isatty():
            raise RuntimeError('Automation requires --profile headless|desktop|kiosk')
        profile = input('Profile (headless / desktop / kiosk): ').strip()
    if profile not in ('headless', 'desktop', 'kiosk'):
        raise RuntimeError('Unknown installation profile')
    backend = select_chromium_backend(options, facts, profile)
    previous_backend = configured_chromium_backend()
    print('Chromium backend:', backend, '(XWayland)' if backend == 'x11' else '(native Wayland)')
    endpoint = options.moonraker or installed_endpoint() or state.get('moonraker')
    if getattr(options, 'command', None) == 'configure' and sys.stdin.isatty() and not options.moonraker:
        endpoint = input(f'Moonraker IP, hostname or URL [{endpoint or "localhost:7125"}]: ').strip() or endpoint or 'localhost:7125'
    if not endpoint and sys.stdin.isatty():
        endpoint = prompt_endpoint()
    if not endpoint:
        raise RuntimeError('Automation requires --moonraker URL')
    endpoint = moonraker(endpoint)
    dist = Path(options.dist).resolve() if options.dist else (ROOT / 'current').resolve()
    if not options.dist and not (dist / 'index.html').is_file():
        dist = DEPLOY.parent / 'dist'
    if not (dist / 'index.html').is_file():
        raise RuntimeError('Prebuilt assets missing: pass --dist DIR (build on a supported workstation; Node is not installed on targets)')
    port = '7180'
    env_file = ROOT / 'layr.env'
    if env_file.is_file():
        match = re.search(r'^LAYR_PORT=([0-9]+)$', env_file.read_text(), re.M)
        if match:
            port = match[1]
    if not 1 <= int(port) <= 65535 or int(port) == 7125:
        raise RuntimeError('Saved LAYR port is invalid; repair layr.env before continuing')
    if facts['disk_free_mb'] < 256:
        raise RuntimeError('At least 256 MiB free space is required before installation')
    packages = ['python3', 'curl', 'ca-certificates']
    if profile == 'kiosk':
        if facts['ram_mb'] < 512:
            raise RuntimeError('Dedicated Chromium kiosk requires at least 512 MiB RAM')
        if facts['services']['display-manager.service'] == 'active':
            raise RuntimeError('Desktop display manager is active; use --profile desktop to preserve its session')
        if any(facts['graphical_environment'].get(key) for key in ('DISPLAY', 'WAYLAND_DISPLAY')):
            raise RuntimeError('Graphical session detected; use --profile desktop')
        if 'connected' not in facts['connectors'].values():
            raise RuntimeError('No connected DRM display found; use --profile headless or attach the kiosk display')
        packages += ['cage', 'chromium', 'libpam-systemd', 'dbus-user-session', 'libinput-tools', 'kbd', 'libgl1-mesa-dri', 'libegl1', 'libgbm1', 'polkitd']
        if backend == 'x11':
            packages.append('xwayland')
    for package in packages:
        policy = capture('apt-cache', 'policy', package)
        if not re.search(r'Candidate:\s+(?!\(none\))\S+', policy):
            raise RuntimeError(f'No compatible APT candidate for {package} on {facts["architecture"]}; check Bookworm repositories (no changes made)')
    apt_plan(packages)
    runtime_preflight(profile)
    reachable, detail = probe_moonraker(endpoint)
    print(f'Moonraker connectivity: {detail}')
    if not reachable and not getattr(options, 'allow_offline', False):
        raise RuntimeError('Moonraker connectivity failed; check address/port/authorization or explicitly use --allow-offline to stage installation')
    if getattr(options, 'command', None) == 'preflight':
        print('preflight=ok; changed=no; Node.js is not required on targets')
        return
    if not options.yes and not options.dry_run:
        if not sys.stdin.isatty() or input(f'Install {profile}, Moonraker {endpoint}? [y/N] ').lower() != 'y':
            raise RuntimeError('Cancelled; use --yes for automation')
    autostart = getattr(options, 'autostart', False)
    if autostart and profile != 'kiosk':
        raise RuntimeError('--autostart requires --profile kiosk')
    # Phase 1: a useful, independently validated web service comes first.
    install_packages(['python3', 'curl', 'ca-certificates'], options.dry_run)
    args = ['bash', DEPLOY / 'install.sh', '--dist', dist, '--moonraker', endpoint, '--port', port, '--yes', '--headless']
    if options.dry_run:
        args.append('--dry-run')
    execute(args)
    if not options.dry_run:
        http = probe_web()
        if not http['ok']:
            raise RuntimeError('Web installation finished but local HTTP validation failed: ' + http['error'] + '. Kiosk was not started. Use layr kiosk-diagnose; recovery: layr recover')
    if profile == 'kiosk':
        # Disable persistence before any later kiosk phase can fail. This does not
        # stop an existing graphical process or affect another display service.
        if capture('systemctl', 'list-unit-files', '--no-legend', 'layr-kiosk.service').startswith('layr-kiosk.service '):
            execute(['sudo', 'systemctl', 'disable', 'layr-kiosk.service'], options.dry_run)
        try:
            install_packages(packages[3:], options.dry_run)
            kiosk_args = ['bash', DEPLOY / 'install.sh', '--kiosk-only', '--dist', dist, '--moonraker', endpoint, '--port', port, '--yes']
            if options.dry_run:
                kiosk_args.append('--dry-run')
            execute(kiosk_args)
        except subprocess.SubprocessError as error:
            raise RuntimeError('Web service is installed; kiosk setup failed and was not started. Check layr kiosk-diagnose; SSH recovery: layr recover') from error
    if not options.dry_run:
        if backend != previous_backend:
            if profile != 'kiosk' and capture('systemctl', 'list-unit-files', '--no-legend', 'layr-kiosk.service').startswith('layr-kiosk.service '):
                execute(['sudo', 'systemctl', 'disable', 'layr-kiosk.service'])
            invalidate_display_confirmation()
        save_chromium_backend(backend)
        path = ROOT / 'state/installer.json'
        path.parent.mkdir(parents=True, exist_ok=True)
        temp = path.with_suffix('.tmp')
        temp.write_text(json.dumps(dict(profile=profile, moonraker=endpoint)) + '\n')
        temp.replace(path)
    print(f'Preview: http://127.0.0.1:{port}/?moonraker={quote(endpoint, safe="")}#/home')
    if autostart:
        if display_confirmed() and capture('systemctl', 'is-active', 'KlipperScreen.service') != 'active':
            flags = ['--yes'] + (['--dry-run'] if options.dry_run else [])
            execute(['bash', DEPLOY / 'layr-display.sh', 'to-layr', *flags], options.dry_run)
        else:
            print('Automatic kiosk startup is held until a visible display test succeeds. Use layr switch layr, then layr enable-kiosk after physical confirmation.')
    print('Web installation complete; graphical display and touchscreen remain unverified.' if not options.dry_run else 'Dry run complete; no installation changes made.')
    print('Management: layr; SSH recovery: layr recover; rollback: layr rollback --yes; uninstall: layr uninstall --yes')
    print('Kiosk preview: layr switch layr. Boot startup remains a separate, physically confirmed action.')



def install_packages(packages, dry=False):
    execute(['sudo', 'env', 'DEBIAN_FRONTEND=noninteractive', 'NEEDRESTART_MODE=l', 'apt-get', 'install', '-y', '--no-remove', '--no-install-recommends', '-o', 'Dpkg::Options::=--force-confold', *packages], dry)


def apt_plan(packages):
    result = subprocess.run(['apt-get', '--simulate', '--no-remove', '--no-install-recommends', 'install', *packages], capture_output=True, text=True, timeout=60)
    if result.returncode:
        raise RuntimeError('APT dependency resolution failed before changes: ' + result.stderr.strip())


def runtime_preflight(profile):
    if not Path('/run/systemd/system').is_dir():
        raise RuntimeError('A running systemd system is required; containers/chroots without systemd are unsupported')
    if profile == 'kiosk':
        if not Path('/dev/tty7').exists() or not list(Path('/dev/dri').glob('card*')):
            raise RuntimeError('Kiosk requires a Linux VT (/dev/tty7) and DRM device (/dev/dri/card*); check kernel graphics support')


def probe_moonraker(endpoint):
    # A reachable HTTP server is insufficient: require a Moonraker API result.
    try:
        result = subprocess.run(['curl', '--fail', '--silent', '--show-error', '--connect-timeout', '3', '--max-time', '8', '--max-filesize', '2000000', '--proto', '=http,https', endpoint + '/server/info'], text=True, capture_output=True, timeout=10)
        if result.returncode:
            return False, f'HTTP/network failure: {result.stderr.strip()}'
        data = json.loads(result.stdout)
        if not isinstance(data, dict) or not isinstance(data.get('result'), dict) or 'moonraker_version' not in data['result']:
            return False, 'response is not a Moonraker server/info result'
        return True, 'Moonraker API reachable (browser CORS/WebSocket access still needs device validation)'
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        return False, str(error)


def display_config(options):
    print_hardware(detect())
    cursor = options.cursor
    if not cursor and sys.stdin.isatty() and not getattr(options, 'inventory_only', False):
        cursor = input('Cursor: hidden / visible [leave unchanged]: ').strip()
    if cursor:
        path = ROOT / 'layr.env'
        if not path.is_file():
            raise RuntimeError('Install LAYR before saving display settings')
        if cursor not in ('hidden', 'visible'):
            raise RuntimeError('Cursor must be hidden or visible')
        if not options.dry_run:
            lines = [line for line in path.read_text().splitlines() if not line.startswith('LAYR_HIDE_CURSOR=')]
            temp = path.with_suffix('.tmp')
            with os.fdopen(os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as handle:
                handle.write('\n'.join(lines + ['LAYR_HIDE_CURSOR=' + ('1' if cursor == 'hidden' else '0')]) + '\n')
            temp.chmod(0o600)
            temp.replace(path)
        print('Cursor setting saved (dry run)' if options.dry_run else 'Cursor setting saved; restart the active kiosk to apply')
    print('Touchscreen inventory: sudo libinput list-devices')
    print('Touch event test: sudo timeout 15s libinput debug-events (exit 124 means sampling timeout)')
    print('Resolution uses the panel preferred mode. Rotation/calibration changes are not implemented; no input rules or boot files were changed.')


def power_module():
    path = DEPLOY / 'layr-display-power.py'
    if not path.is_file() or not path.read_text().rstrip().endswith('\n# LAYR_SCRIPT_END'):
        raise RuntimeError('Complete display-power module missing; use a reviewed installer update')
    spec = importlib.util.spec_from_file_location('layr_display_power', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def trusted_power_helper():
    for directory in (POWER_HELPER.parent, *POWER_HELPER.parent.parents):
        if directory.is_symlink() or (directory.exists() and (directory.stat().st_uid != 0 or directory.stat().st_mode & 0o022)):
            raise RuntimeError('Privileged display-power directory is not trusted: ' + str(directory))
    if POWER_HELPER.exists() or POWER_HELPER.is_symlink():
        info = POWER_HELPER.lstat()
        if POWER_HELPER.is_symlink() or info.st_uid != 0 or info.st_mode & 0o022 or not POWER_HELPER.read_text().startswith('#!/usr/bin/python3\n# LAYR-managed display power controller v1.'):
            raise RuntimeError('Existing privileged display-power helper is not a trusted LAYR copy')


def display_power(options):
    action = options.target or 'status'
    if action not in ('status', 'diagnose', 'enable', 'disable', 'configure', 'wake'):
        raise RuntimeError('Display power: use status, diagnose, enable, disable, configure or wake')
    module = power_module()
    if action in ('status', 'diagnose'):
        data = module.diagnostics()
        if getattr(options, 'json', False):
            print(json.dumps(data, indent=2))
        else:
            config = data['settings']
            support = data['support']
            print('Display power:', 'enabled (opt-in)' if config['enabled'] else 'disabled (default)')
            print('Hardware support:', 'capability checks passed; physical validation required' if support['supported'] else '; '.join(support['reasons']))
            for device in support['backlights']:
                print('Backlight:', device['name'], f"brightness={device['brightness']}/{device['maximum']} bl_power={device['bl_power']}")
            for device in support['inputs']:
                if device['power']:
                    print('Power button:', device['name'], device['node'])
            timeout = config['timeout_minutes']
            print('Screen off:', 'Never' if timeout is None else str(timeout) + ' minutes')
            print('Dim before off:', f"{config['dim_percent']}% after {timeout * 48:g} seconds" if config['dim'] and timeout is not None else 'disabled')
            print('Wake: short power-button press; SSH: layr display-power wake')
            print('Controller:', data['runtime'].get('state', 'unknown'))
            service = data.get('service', {})
            print('Service:', service.get('stdout') or service.get('stderr') or 'unknown/not installed')
            if data['runtime'].get('session_ready') is False:
                print('Waiting for the kiosk local session; idle transitions are held.')
            print(data['logind_policy'])
            print(data['note'])
            print('Detailed JSON: layr display-power diagnose --json; logs: sudo journalctl -u layr-display-power -b')
        return
    require_privileges(interactive=not options.yes)
    values = {}
    for attr, key in (('idle_minutes', 'timeout_minutes'), ('power_dim', 'dim'), ('dim_percent', 'dim_percent'), ('wake_method', 'wake_method'), ('backlight', 'backlight')):
        value = getattr(options, attr, None)
        if value is not None:
            values[key] = None if attr == 'idle_minutes' and value == 'never' else (int(value) if attr == 'idle_minutes' else value)
    module.settings(values)
    if action in ('enable', 'configure'):
        if saved().get('profile') != 'kiosk':
            raise RuntimeError('Display power requires the explicitly selected kiosk profile; headless/desktop and Raspberry Pi defaults are unchanged')
        previous = module.Manager().config()
        support = module.discover(selected=values.get('backlight', previous.get('backlight')))
        if not support['supported']:
            raise RuntimeError('; '.join(support['reasons']))
        for name in ('systemd-inhibit', 'udevadm', 'loginctl'):
            if not shutil.which(name):
                raise RuntimeError(f'{name} is required before enabling display power; no packages/settings changed')
        if action == 'enable' and capture('systemctl', 'is-active', 'layr-kiosk.service') != 'active':
            raise RuntimeError('Start and physically validate a service-based kiosk preview first')
    # Validate before EVERY root invocation, including wake/disable/recovery.
    trusted_power_helper()
    if action != 'wake' and not options.yes and not options.dry_run:
        message = 'Enable display dim/off? Short power presses will wake the screen while this service runs. Linux keeps running.' if action == 'enable' else 'Apply display-power ' + action + '?'
        if not sys.stdin.isatty() or input(message + ' [y/N] ').strip().lower() != 'y':
            raise RuntimeError('Cancelled; no display-power changes made')
    if action in ('enable', 'configure'):
        # Never execute a root daemon out of the user-writable management tree.
        execute(['sudo', 'install', '-d', '-o', 'root', '-g', 'root', '-m', '755', POWER_HELPER.parent], options.dry_run)
        execute(['sudo', 'install', '-o', 'root', '-g', 'root', '-m', '755', DEPLOY / 'layr-display-power.py', POWER_HELPER], options.dry_run)
    elif not POWER_HELPER.is_file():
        if action == 'disable':
            print('Display power is disabled; its optional root service is not installed.')
            return
        raise RuntimeError('No installed display-power controller; use display-power status or enable first')
    args = ['sudo', '/usr/bin/python3', '-I', POWER_HELPER, action]
    if values:
        args += ['--settings', json.dumps(values)]
    execute(args, options.dry_run)
    print('Display-power ' + action + (' planned; no changes made.' if options.dry_run else ' completed. Check status/journal and validate on the physical device.'))
    print('Recovery: layr display-power wake; disable: layr display-power disable. Normal local shutdown: sudo systemctl poweroff')


