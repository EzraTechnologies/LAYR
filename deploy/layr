def kiosk_diagnostics():
    commands = [
        ['systemctl', 'show', 'layr-kiosk.service', '-p', 'ActiveState', '-p', 'SubState', '-p', 'MainPID', '-p', 'NRestarts', '-p', 'ExecMainStatus', '-p', 'User', '-p', 'PAMName', '-p', 'TTYPath', '-p', 'ControlGroup'],
        ['systemctl', 'cat', 'layr-kiosk.service'],
        ['cat', '/etc/pam.d/layr-kiosk'],
        ['journalctl', '-b', '-u', 'layr-kiosk.service', '-u', 'layr-web.service', '-n', '200', '--no-pager', '-o', 'short-monotonic'],
        ['loginctl', 'list-sessions', '--no-legend'],
        ['systemctl', 'status', 'polkit.service', 'systemd-logind.service', 'dbus.service', '--no-pager'],
        ['pkaction', '--action-id', 'org.freedesktop.login1.chvt', '--verbose'],
        ['id'],
        ['cage', '-h'],
        [shutil.which('chromium') or shutil.which('chromium-browser') or 'chromium', '--version'],
        ['dpkg-query', '-W', 'cage', 'chromium', 'libwlroots10', 'libpam-systemd', 'dbus-user-session', 'libegl1', 'libgbm1', 'libgl1-mesa-dri', 'libinput-tools', 'libwayland-client0', 'libwayland-server0', 'libgles2', 'libseat1', 'polkitd', 'xwayland'],
    ]
    results = [run_probe(command) for command in commands]
    processes = run_probe(['ps', '-eo', 'pid,ppid,sid,pgid,tty,stat,comm'])
    if processes['stdout']:
        processes['stdout'] = '\n'.join(line for line in processes['stdout'].splitlines() if re.search(r'cage|chromium|Xwayland|sd-pam|layr', line))
    results.append(processes)
    nodes = []
    for path in [Path('/dev/tty7'), *sorted(Path('/dev/dri').glob('*'))]:
        try:
            info = path.stat()
            nodes.append(dict(path=str(path), mode=oct(info.st_mode & 0o777), uid=info.st_uid, gid=info.st_gid, invoking_user_read=os.access(path, os.R_OK), invoking_user_write=os.access(path, os.W_OK)))
        except OSError as error:
            nodes.append(dict(path=str(path), error=str(error)))
    process_env = {}
    pid = capture('systemctl', 'show', 'layr-kiosk.service', '-p', 'MainPID', '--value')
    if pid.isdigit() and int(pid) > 0:
        try:
            allowed = {'XDG_RUNTIME_DIR', 'WAYLAND_DISPLAY', 'DISPLAY', 'XDG_SESSION_TYPE', 'XDG_SEAT', 'XDG_VTNR', 'DBUS_SESSION_BUS_ADDRESS', 'XDG_SESSION_ID', 'LIBSEAT_BACKEND', 'WLR_BACKENDS', 'WLR_RENDERER', 'LAYR_CHROMIUM_BACKEND'}
            for field in Path(f'/proc/{pid}/environ').read_bytes().split(b'\0'):
                key, _, value = field.partition(b'=')
                if key.decode(errors='replace') in allowed:
                    process_env[key.decode()] = value.decode(errors='replace')
        except OSError as error:
            process_env['read_error'] = str(error)
    if process_env.get('XDG_SESSION_ID'):
        results.append(run_probe(['loginctl', 'show-session', process_env['XDG_SESSION_ID'], '-p', 'User', '-p', 'Seat', '-p', 'VTNr', '-p', 'Type', '-p', 'Class', '-p', 'Active', '-p', 'Leader', '-p', 'Remote']))
    return dict(probes=results, device_permissions=nodes, service_session_environment=process_env, chromium_backend=configured_chromium_backend(),
                interpretation='Active process, DRM nodes, a display variable or HTTP response do not establish visible rendering. Journal access failures must be reported; rerun journalctl with sudo if denied. Manual Cage/X11 touch operation does not validate the service session or boot startup.')


