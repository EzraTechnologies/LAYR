                    continue
            elif options.command == 'configure':
                options.command = submenu('Moonraker connections', [('1', 'Show current connection', 'status'), ('2', 'Change connection', 'configure')])
            elif options.command == 'display-menu':
                action = submenu('Display and touchscreen', [('1', 'Show inventory', 'inventory'), ('2', 'Hide cursor', 'hidden'), ('3', 'Show cursor', 'visible'), ('4', 'Chromium X11 / XWayland (recommended for older Intel tablets)', 'x11'), ('5', 'Chromium native Wayland (Raspberry Pi default)', 'wayland'), ('6', 'Display power management (optional Intel tablet feature)', 'power')])
                if action is None:
                    continue
                if action == 'power':
                    if not power_menu(options):
                        continue
                    input('Press Enter to return to the main menu...')
                    continue
                options.command = 'backend' if action in ('x11', 'wayland') else 'display'
                options.chromium_backend = action if options.command == 'backend' else None
                options.cursor = action if action != 'inventory' else None
                options.inventory_only = action == 'inventory'
            if options.command is None:
                continue
            dispatch(options)
            print('Operation completed. Review the reported verification limits above.')
        except EOFError:
            print('\nEnd of input. Exiting LAYR.')
            return
        except KeyboardInterrupt:
            if options is None or options.command is None:
                print('\nExiting LAYR.')
                return
            print('\nOperation cancelled. Completed steps may remain; check status before retrying.')
        except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as error:
            print(f'Operation failed: {error}')
        try:
            input('Press Enter to return to the main menu...')
        except EOFError:
            print('\nEnd of input. Exiting LAYR.')
            return
        except KeyboardInterrupt:
            print()


def dispatch(options):
    if options.command not in ('diagnose', 'status', 'kiosk-diagnose') and not (options.command == 'display-power' and options.target in (None, 'status', 'diagnose')):
        require_owner()
    if options.command in ('preflight', 'install', 'update', 'repair', 'start', 'stop', 'restart', 'switch', 'rollback', 'uninstall', 'recover', 'enable-kiosk'):
        # Validate before profile/endpoint/update prompts and before delegating
        # to any privileged recovery or service operation. --yes never prompts.
        require_privileges(interactive=not options.yes)
    if options.command in ('diagnose', 'status', 'kiosk-diagnose'):
        facts = status_snapshot()
        if options.command == 'kiosk-diagnose':
            facts['kiosk_diagnostics'] = kiosk_diagnostics()
        if options.command == 'diagnose' or getattr(options, 'json', False):
            print(json.dumps(facts, indent=2))
        else:
            print_status(facts)
            if options.command == 'kiosk-diagnose':
                print_diagnostics(facts['kiosk_diagnostics'])
    elif options.command == 'enable-kiosk':
        enable_kiosk(options)
    elif options.command == 'display':
        display_config(options)
    elif options.command == 'backend':
        backend_config(options)
    elif options.command == 'display-power':
        display_power(options)
    elif options.command == 'configure':
        configure(options)
    elif options.command in ('start', 'stop', 'restart'):
        service_control(options.command, options.dry_run)
    elif options.command in ('install', 'repair', 'update', 'preflight'):
        if options.command == 'update' and not options.dist:
            if sys.stdin.isatty():
                options.dist = input('Reviewed new build directory: ').strip()
            if not options.dist:
                raise RuntimeError('Update requires --dist DIR containing the reviewed new build')
        install(options, detect())
    else:
        flags = (['--yes'] if options.yes else []) + (['--dry-run'] if options.dry_run else [])
        if options.command == 'switch':
            if options.target not in ('layr', 'klipperscreen'):
                raise RuntimeError('Specify layr or klipperscreen')
            if options.target == 'layr' and capture('systemctl', 'is-active', 'display-manager.service') == 'active':
                raise RuntimeError('Desktop session active; open the preview URL in your desktop browser')
            execute(['bash', DEPLOY / 'layr-display.sh', 'to-' + options.target, *(['--preview'] if options.target == 'layr' else []), *flags])
        elif options.command == 'recover':
            execute(['sudo', 'systemctl', 'disable', '--now', 'layr-kiosk.service'], options.dry_run)
            print('Kiosk disabled. Console: sudo chvt 1. If installed: layr switch klipperscreen. Previous UI: layr rollback --yes')
        else:
            execute(['bash', DEPLOY / (options.command + '.sh'), *flags])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', nargs='?', choices=['preflight', 'display', 'display-power', 'backend', 'status', 'start', 'stop', 'restart', 'install', 'configure', 'update', 'repair', 'diagnose', 'rollback', 'uninstall', 'recover', 'switch', 'kiosk-diagnose', 'enable-kiosk'])
    parser.add_argument('target', nargs='?', choices=['layr', 'klipperscreen', 'status', 'diagnose', 'enable', 'disable', 'configure', 'wake'])
    parser.add_argument('--allow-offline', action='store_true', help='Explicitly allow unreachable Moonraker during installation')
    parser.add_argument('--autostart', action='store_true', help='Request automatic startup; held until physical confirmation via enable-kiosk')
    parser.add_argument('--json', action='store_true', help='Detailed status/diagnostics as JSON')
    parser.add_argument('--cursor', choices=['hidden', 'visible'])
    parser.add_argument('--idle-minutes', choices=['1', '5', '10', 'never'])
    parser.add_argument('--dim', dest='power_dim', action=argparse.BooleanOptionalAction, default=None)
    parser.add_argument('--dim-percent', type=int)
    parser.add_argument('--wake-method', choices=['power-button'])
    parser.add_argument('--backlight', help='Explicit discovered backlight class name when selection is ambiguous')
    parser.add_argument('--chromium-backend', choices=['wayland', 'x11'], help='Browser Ozone backend; X11 uses Cage XWayland. Existing installations default to their saved value, otherwise Wayland.')
    parser.add_argument('--profile', choices=['headless', 'desktop', 'kiosk'])
    parser.add_argument('--moonraker')
    parser.add_argument('--dist', help='Reviewed prebuilt web distribution; required for fresh install and update')
    parser.add_argument('--yes', action='store_true')
    parser.add_argument('--dry-run', action='store_true')
    options = parser.parse_args()
    if options.command is None:
        if not sys.stdin.isatty():
            parser.print_help()
            return
        interactive_menu(options)
        return
    dispatch(options)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        print('LAYR: cancelled. Completed steps may remain; check layr status.', file=sys.stderr)
        sys.exit(130)
    except EOFError:
        print('LAYR: input ended; requested operation stopped.', file=sys.stderr)
        sys.exit(1)
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'LAYR: {error}', file=sys.stderr)
        sys.exit(1)
