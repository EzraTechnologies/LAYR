def require_owner():
    if os.geteuid() == 0:
        raise RuntimeError('Run layr as its installation owner, not root')
    if ROOT.exists() and ROOT.stat().st_uid != os.getuid():
        raise RuntimeError(f'Run layr as the owner of {ROOT}')
    os.environ['LAYR_HOME'] = str(ROOT)


def configure(options):
    """Configure the connection without APT, new releases or lost rollback state."""
    path = ROOT / 'layr.env'
    if not path.is_file():
        raise RuntimeError('LAYR is not installed; run layr install first')
    state = saved()
    profile = state.get('profile')
    if options.profile and options.profile != profile:
        raise RuntimeError('Profile changes require layr install --profile (dependencies and services must be checked)')
    values = dict(line.split('=', 1) for line in path.read_text().splitlines() if '=' in line)
    endpoint = options.moonraker
    if not endpoint:
        if not sys.stdin.isatty():
            raise RuntimeError('Automation requires --moonraker URL')
        default = values.get('LAYR_MOONRAKER_URL', 'http://localhost:7125')
        endpoint = prompt_endpoint(default)
    endpoint = moonraker(endpoint)
    reachable, detail = probe_moonraker(endpoint)
    print(f'Moonraker connectivity: {detail}')
    if not reachable and not getattr(options, 'allow_offline', False):
        raise RuntimeError('Moonraker connectivity failed; existing configuration retained (or explicitly use --allow-offline)')
    if not options.yes and not options.dry_run:
        if not sys.stdin.isatty() or input(f'Save Moonraker {endpoint}? [y/N] ').lower() != 'y':
            raise RuntimeError('Cancelled; use --yes for automation')
    if not options.dry_run:
        lines = [line for line in path.read_text().splitlines() if not line.startswith('LAYR_MOONRAKER_URL=')]
        temp = path.with_suffix('.tmp')
        # Restrict before writing, so no broader-permission intermediate file exists.
        with os.fdopen(os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as handle:
            handle.write('\n'.join(lines + ['LAYR_MOONRAKER_URL=' + endpoint]) + '\n')
        temp.chmod(0o600)
        temp.replace(path)
        # The env file is authoritative. Ignore any older endpoint in installer.json.
    print(f'Moonraker: {endpoint}' + (' (dry run)' if options.dry_run else ' saved; restart the active kiosk to apply'))
    port = values.get('LAYR_PORT', '7180')
    print(f'Preview: http://127.0.0.1:{port}/?moonraker={quote(endpoint, safe="")}#/home')


def service_control(action, dry=False):
    require_privileges(interactive=sys.stdin.isatty())
    # Resume only an already-enabled dedicated kiosk; a first activation is explicit.
    if action == 'start':
        execute(['sudo', 'systemctl', 'start', 'layr-web.service'], dry)
        if capture('systemctl', 'is-enabled', 'layr-kiosk.service') == 'enabled':
            if capture('systemctl', 'is-active', 'KlipperScreen.service') == 'active':
                raise RuntimeError('KlipperScreen is active; web started, display unchanged. Use layr switch layr to switch explicitly')
            flags = ['--yes'] + (['--dry-run'] if dry else [])
            execute(['bash', DEPLOY / 'layr-display.sh', 'to-layr', *([] if display_confirmed() else ['--preview']), *flags], dry)
        else:
            print('Web server started. Activate a dedicated kiosk with: layr switch layr')
    elif action == 'stop':
        if capture('systemctl', 'list-unit-files', '--no-legend', 'layr-kiosk.service').startswith('layr-kiosk.service '):
            execute(['sudo', 'systemctl', 'stop', 'layr-kiosk.service'], dry)
        execute(['sudo', 'systemctl', 'stop', 'layr-web.service'], dry)
        print('LAYR stopped temporarily; boot enablement is unchanged. Use layr recover to disable the kiosk.')
    else:
        execute(['sudo', 'systemctl', 'restart', 'layr-web.service'], dry)
        if capture('systemctl', 'is-active', 'layr-kiosk.service') == 'active':
            execute(['sudo', 'systemctl', 'restart', 'layr-kiosk.service'], dry)



def input_bitmap(path, word_bits):
    try:
        value = 0
        for word in re.split(r'[\s,]+', path.read_text().strip()):
            value = (value << word_bits) | int(word, 16)
        return value
    except (OSError, ValueError):
        return 0


def touch_inventory(base, inputs):
    devices = []
    kernel = capture('uname', '-m') or os.uname().machine
    word_bits = 64 if kernel in ('x86_64', 'aarch64', 'arm64', 'amd64') else 32
    for event in sorted((base / 'sys/class/input').glob('event*')):
        properties = capture('udevadm', 'info', '--query=property', '--path', str(event))
        source = None
        if 'ID_INPUT_TOUCHSCREEN=1' in properties.splitlines():
            source = 'udev ID_INPUT_TOUCHSCREEN'
        else:
            # Standard kernel input interfaces distinguish direct touch from a
            # touchpad, regardless of names such as ELAN1001 or Goodix.
            direct = input_bitmap(event / 'device/properties', word_bits) & (1 << 1)
            absolute = input_bitmap(event / 'device/capabilities/abs', word_bits)
            keys = input_bitmap(event / 'device/capabilities/key', word_bits)
            multitouch_xy = absolute & ((1 << 53) | (1 << 54)) == ((1 << 53) | (1 << 54))
            single_touch = absolute & 3 == 3 and keys & (1 << 330)
            if direct and (multitouch_xy or single_touch):
                source = 'kernel direct-touch properties/capabilities'
        if source:
            name = event / 'device/name'
            devices.append(dict(event=event.name, node='/dev/input/' + event.name, name=name.read_text().strip() if name.is_file() else 'unnamed', source=source))
    if devices:
        source = 'udev' if any('udev' in device['source'] for device in devices) else 'kernel input interfaces'
        return dict(detection='identified by ' + source + '; function unverified', devices=devices)
    if inputs.exists() and re.search(r'touch|goodix|egalax|ads7846', inputs.read_text(), re.I):
        return dict(detection='possible touchscreen by name; function unverified', devices=[])
    return dict(detection='not identified; inspect libinput/kernel logs (absence not established)', devices=[])


