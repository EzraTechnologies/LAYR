# Native Qt kiosk: Cage on tty7, one full-screen Qt Quick client.
# kiosk-install.sh installs this unit and does not enable or start it.
# kiosk-switch.sh is the only supported way to take the panel.
# @VARS@ are replaced at install time. Klipper and Moonraker are not restarted.
[Unit]
Description=LAYR native Qt kiosk (Cage on tty7)
After=systemd-user-sessions.service network-online.target
Conflicts=getty@tty7.service
ConditionPathExists=/dev/tty7

[Service]
Type=simple
User=@USER@
PAMName=login
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
# Refuse to start while another panel owns the display. Do not stop them from here.
ExecStartPre=/bin/sh -c 'if systemctl is-active --quiet KlipperScreen.service || systemctl is-active --quiet layr-kiosk.service || systemctl is-active --quiet layr-qt-test.service; then echo "Another display is running. Use native-qt/scripts/kiosk-switch.sh." >&2; exit 1; fi'
ExecStartPre=/usr/bin/chvt 7
ExecStart=@ROOT@/scripts/qt-kiosk.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
