# Copy to ~/.config/layr-qt/layr-qt.env or ./layr-qt.env if you want overrides.
# launch-session.sh reads the file when it exists. Nothing here is required.
# Do not put an API key in this file. Prefer Moonraker trusted_clients for 127.0.0.1.
# If you truly need a key, export LAYR_QT_API_KEY in the shell for that session only.

# LAYR_QT_MOONRAKER_URL=http://localhost:7125

# Safe default: a VNC framebuffer that does not take the HDMI panel.
# Other values: xcb, wayland, offscreen. eglfs and linuxfb also need LAYR_QT_ALLOW_KMS=1.
# LAYR_QT_PLATFORM=vnc
# LAYR_QT_VNC_PORT=5900
# LAYR_QT_SIZE=1024x600

# LAYR_QT_ALLOW_KMS=0
